# Azienda — environment template. Copy to .env and fill in. NEVER commit real secrets.
# Prefix for app settings: AZIENDA_

# --- Core ---
AZIENDA_ENVIRONMENT=development
AZIENDA_DATABASE_URL=postgresql+asyncpg://azienda:azienda@postgres:5432/azienda
AZIENDA_REDIS_URL=redis://redis:6379/0
AZIENDA_DEBUG=false
AZIENDA_VERSION=0.1.0

# --- Auth (generate: openssl rand -hex 32) ---
AZIENDA_JWT_SECRET=
AZIENDA_JWT_ACCESS_TTL_MINUTES=10
AZIENDA_JWT_REFRESH_TTL_DAYS=7
AZIENDA_JWT_ISSUER=azienda
AZIENDA_JWT_ALGORITHM=HS256
AZIENDA_BCRYPT_ROUNDS=12
AZIENDA_API_KEY_PREFIX=azk_

# --- Object storage (S3-compatible) ---
AZIENDA_S3_ENDPOINT=http://minio:9000
AZIENDA_S3_ACCESS_KEY=minioadmin
AZIENDA_S3_SECRET_KEY=minioadmin
AZIENDA_S3_BUCKET=azienda

# --- Model providers (at least one for agent features) ---
# AZIENDA_OPENAI_API_KEY=
# AZIENDA_ANTHROPIC_API_KEY=
# AZIENDA_OPENROUTER_API_KEY=
AZIENDA_DEFAULT_MODEL_PROVIDER=openrouter
AZIENDA_DEFAULT_MODEL=

# --- Governance knobs ---
# Risk bands: score < RISK_LOW_MAX -> LOW; score >= RISK_HIGH_MIN -> HIGH; else MEDIUM.
AZIENDA_RISK_LOW_MAX=30
AZIENDA_RISK_HIGH_MIN=70
# Approval requests expire after this many seconds; timeout == DENY (fail closed).
AZIENDA_APPROVAL_TTL_SECONDS=900
# MEDIUM-risk actions require human approval when true.
AZIENDA_APPROVAL_MEDIUM_REQUIRE=true
# Estimated action cost above this (USD) forces approval. ASSUMED default; tune with data.
AZIENDA_COST_APPROVAL_THRESHOLD_USD=5.0

# --- Budgets ---
AZIENDA_BUDGET_DEFAULT_CREDITS_MONTHLY=1000.0
# Comma-separated spend fractions that raise alerts.
AZIENDA_BUDGET_ALERT_THRESHOLDS=0.5,0.8,0.95

# --- Billing (pricing is DATA, seeded via CLI `billing-seed-plans`, not code) ---
AZIENDA_BILLING_DEFAULT_PLAN=starter
AZIENDA_BILLING_CURRENCY=USD
# Credits per 1 USD (100 credits = $1.00). Seed plan prices are ASSUMED dev pricing.
AZIENDA_CREDIT_USD_RATE=100.0

# --- Rate limiting (in-process sliding window; Redis/Valkey is future work) ---
AZIENDA_RATE_LIMIT_PER_MINUTE=120
AZIENDA_RATE_LIMIT_BURST=240

# --- Idempotency ---
AZIENDA_IDEMPOTENCY_TTL_HOURS=24

# --- DLP (redaction runs BEFORE audit hashing; hashes cover redacted payloads) ---
AZIENDA_DLP_ENABLED=true

# --- Observability ---
AZIENDA_LOG_LEVEL=INFO
AZIENDA_LOG_JSON=true
# AZIENDA_OTLP_ENDPOINT=http://localhost:4318

# --- Postgres (compose) ---
POSTGRES_USER=azienda
POSTGRES_PASSWORD=azienda
POSTGRES_DB=azienda

# --- MinIO (compose) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
